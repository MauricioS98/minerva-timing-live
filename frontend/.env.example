# Copia según entorno:
#   .env.development  → local (npm run dev / npm run build:local)
#   .env.production   → nube (npm run build:production)
#
# Todas las variables del front deben empezar con VITE_

# Base de la API (sin barra final)
VITE_API_BASE_URL=/api

# Base de archivos estáticos subidos (cabeceras, etc.)
VITE_UPLOADS_BASE_URL=/uploads

# Origen absoluto del backend (feeds, enlaces absolutos)
VITE_BACKEND_ORIGIN=http://localhost:4000
