{
  "name": "minerva-timing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:production --prefix frontend",
    "build:local": "npm run build:local --prefix frontend",
    "build:production": "npm run build:production --prefix frontend",
    "start": "npm start --prefix backend",
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
